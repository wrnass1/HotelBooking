{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hotelbooking;Username=hotelbooking_user;Password=hotelbooking_password",
    "ReadConnection": "Host=localhost;Port=5433;Database=hotelbooking;Username=hotelbooking_reader;Password=lab04_reader_password;Application Name=hotelbooking-catalog-replica",
    "Redis": "localhost:6379"
  },
  "Sharding": {
    "Enabled": true,
    "Strategy": "Modulo",
    "VirtualNodes": 1,
    "Connections": {
      "0": "Host=localhost;Port=5434;Database=hotelbooking_shard;Username=hotelbooking_shard_user;Password=hotelbooking_shard_password;Application Name=hotelbooking-bookings-shard-0",
      "1": "Host=localhost;Port=5435;Database=hotelbooking_shard;Username=hotelbooking_shard_user;Password=hotelbooking_shard_password;Application Name=hotelbooking-bookings-shard-1",
      "2": "Host=localhost;Port=5436;Database=hotelbooking_shard;Username=hotelbooking_shard_user;Password=hotelbooking_shard_password;Application Name=hotelbooking-bookings-shard-2"
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForJWTTokenGenerationThatShouldBeAtLeast32CharactersLong",
    "Issuer": "HotelBooking",
    "Audience": "HotelBooking",
    "ExpiryMinutes": "60"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
